{
  "namespace": "pause",

  "pause_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "phlodgate_quick_settings_panel@pause.phlodgate_quick_settings_panel": {}
        }
      }
    ]
  },

  "phlodgate_quick_settings_panel": {
    "type": "panel",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [0, 24],
    "size": [80, 20],
    "layer": 3,
    "controls": [
      {
        "phlodgate_quick_settings_input": {
          "type": "input_panel",
          "size": ["100%", "100%"],
          "controls": [
            {
              "phlodgate_quick_settings_button@common_buttons.light_text_form_fitting_button": {
                "$pressed_button_name": "button.menu_settings",
                "$form_fitting_min_size": ["100%c + 2px", 22],
                "$button_text": "menu.settings",
                "$pressed_alpha": 0.65
              }
            }
          ]
        }
      }
    ]
  }
}
