{
  "namespace": "hud",

  "phlodgate_minimap_box": {
    "type": "image",
    "texture": "textures/ui/phlodgate/minimap/frame_square",
    "size": ["100%c + 14px", "100%c + 10px"],
    "anchor_from": "$phlodgate_anchor",
    "anchor_to": "$phlodgate_anchor",
    "offset": "$phlodgate_offset",
    "alpha": 0.86,
    "layer": 32,
    "$atext": "$actionbar_text",
    "visible": "(not (($atext - $phlodgate_marker) = $atext))",
    "controls": [
      {
        "map_text": {
          "type": "label",
          "$atext": "$actionbar_text",
          "text": "($atext - $phlodgate_marker)",
          "anchor_from": "center",
          "anchor_to": "center",
          "text_alignment": "$phlodgate_alignment",
          "font_scale_factor": "$phlodgate_font_scale",
          "color": "$tool_tip_text",
          "localize": false,
          "shadow": true,
          "layer": 33
        }
      }
    ]
  },

  "phlodgate_minimap_small@hud.phlodgate_minimap_box": { "$phlodgate_font_scale": 1.0 },
  "phlodgate_minimap_large@hud.phlodgate_minimap_box": { "$phlodgate_font_scale": 1.41 },

  "phlodgate_plain_actionbar": {
    "type": "image",
    "texture": "textures/ui/hud_tip_text_background",
    "size": ["100%c + 12px", "100%c + 5px"],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [0, -72],
    "alpha": 0.6,
    "layer": 30,
    "$atext": "$actionbar_text",
    "visible": "((((($atext - '[PGL:TL1]') = $atext) and (($atext - '[PGL:TL2]') = $atext)) and ((($atext - '[PGL:TR1]') = $atext) and (($atext - '[PGL:TR2]') = $atext))) and (((($atext - '[PGL:BL1]') = $atext) and (($atext - '[PGL:BL2]') = $atext)) and ((($atext - '[PGL:BR1]') = $atext) and (($atext - '[PGL:BR2]') = $atext))))",
    "controls": [
      {
        "actionbar_message": {
          "type": "label",
          "$atext": "$actionbar_text",
          "text": "$atext",
          "anchor_from": "center",
          "anchor_to": "center",
          "color": "$tool_tip_text",
          "localize": false,
          "shadow": true,
          "layer": 31
        }
      }
    ]
  },

  "phlodgate_minimap_root": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      { "phlodgate_plain@hud.phlodgate_plain_actionbar": {} },
      { "phlodgate_top_left_small@hud.phlodgate_minimap_small": { "$phlodgate_marker": "[PGL:TL1]", "$phlodgate_anchor": "top_left", "$phlodgate_offset": [10, 12], "$phlodgate_alignment": "left" } },
      { "phlodgate_top_left_large@hud.phlodgate_minimap_large": { "$phlodgate_marker": "[PGL:TL2]", "$phlodgate_anchor": "top_left", "$phlodgate_offset": [10, 12], "$phlodgate_alignment": "left" } },
      { "phlodgate_top_right_small@hud.phlodgate_minimap_small": { "$phlodgate_marker": "[PGL:TR1]", "$phlodgate_anchor": "top_right", "$phlodgate_offset": [-10, 12], "$phlodgate_alignment": "right" } },
      { "phlodgate_top_right_large@hud.phlodgate_minimap_large": { "$phlodgate_marker": "[PGL:TR2]", "$phlodgate_anchor": "top_right", "$phlodgate_offset": [-10, 12], "$phlodgate_alignment": "right" } },
      { "phlodgate_bottom_left_small@hud.phlodgate_minimap_small": { "$phlodgate_marker": "[PGL:BL1]", "$phlodgate_anchor": "bottom_left", "$phlodgate_offset": [10, -96], "$phlodgate_alignment": "left" } },
      { "phlodgate_bottom_left_large@hud.phlodgate_minimap_large": { "$phlodgate_marker": "[PGL:BL2]", "$phlodgate_anchor": "bottom_left", "$phlodgate_offset": [10, -96], "$phlodgate_alignment": "left" } },
      { "phlodgate_bottom_right_small@hud.phlodgate_minimap_small": { "$phlodgate_marker": "[PGL:BR1]", "$phlodgate_anchor": "bottom_right", "$phlodgate_offset": [-10, -96], "$phlodgate_alignment": "right" } },
      { "phlodgate_bottom_right_large@hud.phlodgate_minimap_large": { "$phlodgate_marker": "[PGL:BR2]", "$phlodgate_anchor": "bottom_right", "$phlodgate_offset": [-10, -96], "$phlodgate_alignment": "right" } }
    ]
  },

  "phlodgate_minimap_factory": {
    "type": "panel",
    "factory": {
      "name": "hud_actionbar_text_factory",
      "control_ids": {
        "hud_actionbar_text": "phlodgate_minimap_root@hud.phlodgate_minimap_root"
      }
    }
  },

  "hud_actionbar_text": { "ignored": true },

  "hud_title_text": {
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [0, -62]
  },

  "hud_title_text/title_frame": { "ignored": true },
  "hud_title_text/subtitle_frame/subtitle_background": { "ignored": true },
  "hud_title_text/subtitle_frame/subtitle": { "font_size": "normal", "offset": [0, 18], "alpha": 1 },

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          { "phlodgate_minimap_factory@hud.phlodgate_minimap_factory": {} }
        ]
      }
    ]
  }
}
