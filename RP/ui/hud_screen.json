{
  "namespace": "hud",

  "phlodgate_minimap_box": {
    "type": "image",
    "texture": "textures/ui/phlodgate/minimap/frame_square",
    "size": "$phlodgate_box_size",
    "anchor_from": "$phlodgate_anchor",
    "anchor_to": "$phlodgate_anchor",
    "offset": "$phlodgate_offset",
    "alpha": 0.86,
    "layer": 20,
    "visible": "(not (($actionbar_text - $phlodgate_marker) = $actionbar_text))",
    "controls": [
      {
        "map_text": {
          "type": "label",
          "text": "($actionbar_text - $phlodgate_marker)",
          "anchor_from": "$phlodgate_anchor",
          "anchor_to": "$phlodgate_anchor",
          "offset": "$phlodgate_text_offset",
          "text_alignment": "$phlodgate_alignment",
          "font_scale_factor": "$phlodgate_font_scale",
          "localize": false,
          "shadow": true,
          "layer": 21
        }
      }
    ]
  },

  "phlodgate_minimap_small@hud.phlodgate_minimap_box": {
    "$phlodgate_box_size": ["25%", "25%"],
    "$phlodgate_font_scale": 1.0
  },

  "phlodgate_minimap_large@hud.phlodgate_minimap_box": {
    "$phlodgate_box_size": ["35.4%", "35.4%"],
    "$phlodgate_font_scale": 1.41
  },

  "hud_actionbar_text": {
    "alpha": "(((((($actionbar_text - '[PGL:TL1]') = $actionbar_text) and (($actionbar_text - '[PGL:TL2]') = $actionbar_text)) and ((($actionbar_text - '[PGL:TR1]') = $actionbar_text) and (($actionbar_text - '[PGL:TR2]') = $actionbar_text))) and (((($actionbar_text - '[PGL:BL1]') = $actionbar_text) and (($actionbar_text - '[PGL:BL2]') = $actionbar_text)) and ((($actionbar_text - '[PGL:BR1]') = $actionbar_text) and (($actionbar_text - '[PGL:BR2]') = $actionbar_text)))) ? 1 : 0)",
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          { "phlodgate_top_left_small@hud.phlodgate_minimap_small": { "$phlodgate_marker": "[PGL:TL1]", "$phlodgate_anchor": "top_left", "$phlodgate_offset": [10, 12], "$phlodgate_text_offset": [6, 4], "$phlodgate_alignment": "left" } },
          { "phlodgate_top_left_large@hud.phlodgate_minimap_large": { "$phlodgate_marker": "[PGL:TL2]", "$phlodgate_anchor": "top_left", "$phlodgate_offset": [10, 12], "$phlodgate_text_offset": [6, 4], "$phlodgate_alignment": "left" } },
          { "phlodgate_top_right_small@hud.phlodgate_minimap_small": { "$phlodgate_marker": "[PGL:TR1]", "$phlodgate_anchor": "top_right", "$phlodgate_offset": [-10, 12], "$phlodgate_text_offset": [-6, 4], "$phlodgate_alignment": "right" } },
          { "phlodgate_top_right_large@hud.phlodgate_minimap_large": { "$phlodgate_marker": "[PGL:TR2]", "$phlodgate_anchor": "top_right", "$phlodgate_offset": [-10, 12], "$phlodgate_text_offset": [-6, 4], "$phlodgate_alignment": "right" } },
          { "phlodgate_bottom_left_small@hud.phlodgate_minimap_small": { "$phlodgate_marker": "[PGL:BL1]", "$phlodgate_anchor": "bottom_left", "$phlodgate_offset": [10, -92], "$phlodgate_text_offset": [6, -4], "$phlodgate_alignment": "left" } },
          { "phlodgate_bottom_left_large@hud.phlodgate_minimap_large": { "$phlodgate_marker": "[PGL:BL2]", "$phlodgate_anchor": "bottom_left", "$phlodgate_offset": [10, -92], "$phlodgate_text_offset": [6, -4], "$phlodgate_alignment": "left" } },
          { "phlodgate_bottom_right_small@hud.phlodgate_minimap_small": { "$phlodgate_marker": "[PGL:BR1]", "$phlodgate_anchor": "bottom_right", "$phlodgate_offset": [-10, -92], "$phlodgate_text_offset": [-6, -4], "$phlodgate_alignment": "right" } },
          { "phlodgate_bottom_right_large@hud.phlodgate_minimap_large": { "$phlodgate_marker": "[PGL:BR2]", "$phlodgate_anchor": "bottom_right", "$phlodgate_offset": [-10, -92], "$phlodgate_text_offset": [-6, -4], "$phlodgate_alignment": "right" } }
        ]
      }
    ]
  },

  "hud_actionbar_text/actionbar_message": {
    "visible": "((((($actionbar_text - '[PGL:TL1]') = $actionbar_text) and (($actionbar_text - '[PGL:TL2]') = $actionbar_text)) and ((($actionbar_text - '[PGL:TR1]') = $actionbar_text) and (($actionbar_text - '[PGL:TR2]') = $actionbar_text))) and (((($actionbar_text - '[PGL:BL1]') = $actionbar_text) and (($actionbar_text - '[PGL:BL2]') = $actionbar_text)) and ((($actionbar_text - '[PGL:BR1]') = $actionbar_text) and (($actionbar_text - '[PGL:BR2]') = $actionbar_text))))"
  },

  "hud_title_text": {
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [0, -66]
  },

  "hud_title_text/title_frame": { "ignored": true },
  "hud_title_text/subtitle_frame/subtitle_background": { "ignored": true },
  "hud_title_text/subtitle_frame/subtitle": { "font_size": "normal", "offset": [0, 18], "alpha": 1 }
}
