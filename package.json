{
  "name": "phlodgate-add-on",
  "version": "0.3.0",
  "private": true,
  "description": "Phlodgate Add-On - standalone Bedrock client enhancement pack (Behavior Pack + Resource Pack).",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@minecraft/server": "2.9.0",
    "@minecraft/server-ui": "2.1.0",
    "@types/node": "^24.10.0",
    "archiver": "^7.0.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4",
    "vitest": "^5.0.1"
  }
}
